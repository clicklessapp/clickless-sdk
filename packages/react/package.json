{
  "name": "@clickless/react",
  "version": "0.1.0",
  "description": "Let the users of a React app reshape its screens and carry out its actions in plain words using text or speech, within limits you declare.",
  "keywords": [
    "react",
    "adaptive-ui",
    "personalization",
    "layout",
    "ai",
    "natural-language"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @clickless/core build && tsup && tsc -p tsconfig.build.json && node scripts/bundle-core-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@clickless/core": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
