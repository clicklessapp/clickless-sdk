  {
    "name": "components named like something every object has are new when the layout lacks them",
    "manifest": "names",
    "layout": {
      "formatVersion": 1,
      "regionId": "names",
      "manifestVersion": "0",
      "order": ["valueOf"],
      "items": { "valueOf": { "w": 12, "h": 1, "hidden": true, "props": {} } }
    },
    "expect": {
      "changes": [
        { "type": "added", "id": "constructor" },
        { "type": "added", "id": "toString" }
      ],
      "layout": {
        "formatVersion": 1,
        "regionId": "names",
        "manifestVersion": "1",
        "order": ["constructor", "toString", "valueOf"],
        "items": {
          "constructor": { "w": 6, "h": 2, "hidden": false, "props": { "toString": "short" } },
          "toString": { "w": 6, "h": 2, "hidden": false, "props": {} },
          "valueOf": { "w": 12, "h": 1, "hidden": true, "props": {} }
        }
      }
    }
  },
  {
    "name": "a prop named like something every object has takes its default when the saved item lacks it",
    "manifest": "names",
    "layout": {
      "formatVersion": 1,
      "regionId": "names",
      "manifestVersion": "0",
      "order": ["toString", "constructor", "valueOf"],
      "items": {
        "constructor": { "w": 6, "h": 2, "hidden": true, "props": {} },
        "toString": { "w": 6, "h": 2, "hidden": false, "props": {} },
        "valueOf": { "w": 12, "h": 1, "hidden": false, "props": {} }
      }
    },
    "expect": {
      "changes": [],
      "layout": {
        "formatVersion": 1,
        "regionId": "names",
        "manifestVersion": "1",
        "order": ["toString", "constructor", "valueOf"],
        "items": {
          "constructor": { "w": 6, "h": 2, "hidden": true, "props": { "toString": "short" } },
          "toString": { "w": 6, "h": 2, "hidden": false, "props": {} },
          "valueOf": { "w": 12, "h": 1, "hidden": false, "props": {} }
        }
      }
    }
