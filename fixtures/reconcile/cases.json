[
  {
    "name": "a layout that already fits the manifest is returned unchanged",
    "manifest": "dashboard",
    "layout": {
      "formatVersion": 1,
      "regionId": "dashboard",
      "manifestVersion": "1",
      "order": ["txns", "balance", "revenue", "alerts", "notes"],
      "items": {
        "balance": { "w": 12, "h": 1, "hidden": false, "props": {} },
        "revenue": { "w": 12, "h": 5, "hidden": true, "props": { "chartType": "line" } },
        "txns": { "w": 8, "h": 4, "hidden": false, "props": { "density": "compact", "pageSize": 50 } },
        "alerts": { "w": 12, "h": 2, "hidden": false, "props": {} },
        "notes": { "w": 4, "h": 2, "hidden": false, "props": { "pinned": true } }
      }
    },
    "expect": {
      "changes": [],
      "layout": {
        "formatVersion": 1,
        "regionId": "dashboard",
        "manifestVersion": "1",
        "order": ["txns", "balance", "revenue", "alerts", "notes"],
        "items": {
          "balance": { "w": 12, "h": 1, "hidden": false, "props": {} },
          "revenue": { "w": 12, "h": 5, "hidden": true, "props": { "chartType": "line" } },
          "txns": { "w": 8, "h": 4, "hidden": false, "props": { "density": "compact", "pageSize": 50 } },
          "alerts": { "w": 12, "h": 2, "hidden": false, "props": {} },
          "notes": { "w": 4, "h": 2, "hidden": false, "props": { "pinned": true } }
        }
      }
    }
  },
