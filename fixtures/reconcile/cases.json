  {
    "name": "an untouched layout is carried to a version that adds and tightens components, and one it no longer shows is set aside",
    "manifest": "dashboard-v2",
    "layout": {
      "formatVersion": 1,
      "regionId": "dashboard",
      "manifestVersion": "1",
      "order": ["balance", "revenue", "txns", "alerts", "notes"],
      "items": {
        "balance": { "w": 12, "h": 1, "hidden": false, "props": {} },
        "revenue": { "w": 6, "h": 3, "hidden": false, "props": { "chartType": "bar" } },
        "txns": { "w": 6, "h": 3, "hidden": false, "props": { "density": "comfortable", "pageSize": 10 } },
        "alerts": { "w": 12, "h": 2, "hidden": false, "props": {} },
        "notes": { "w": 4, "h": 2, "hidden": true, "props": { "pinned": false } }
      }
    },
    "expect": {
      "changes": [
        { "type": "adjusted", "id": "revenue" },
        { "type": "added", "id": "forecast" },
        { "type": "adjusted", "id": "txns" },
        { "type": "added", "id": "summary" }
      ],
      "layout": {
        "formatVersion": 1,
        "regionId": "dashboard",
        "manifestVersion": "2",
        "order": ["balance", "revenue", "forecast", "txns", "alerts", "summary"],
        "items": {
          "balance": { "w": 12, "h": 1, "hidden": false, "props": {} },
          "revenue": { "w": 8, "h": 3, "hidden": false, "props": { "chartType": "line" } },
          "forecast": { "w": 4, "h": 3, "hidden": false, "props": {} },
          "txns": { "w": 6, "h": 3, "hidden": false, "props": { "density": "comfortable", "pageSize": 25 } },
          "alerts": { "w": 12, "h": 2, "hidden": false, "props": {} },
          "summary": { "w": 12, "h": 1, "hidden": false, "props": {} }
        },
        "offScreen": {
          "order": ["balance", "revenue", "forecast", "txns", "alerts", "summary", "notes"],
          "items": {
            "notes": { "w": 4, "h": 2, "hidden": true, "props": { "pinned": false } }
          }
        }
      }
    }
  },
