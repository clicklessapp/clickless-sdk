  },
  {
    "name": "a number range that holds nothing",
    "actions": [
      { "name": "setWeight", "title": "Record a weight", "mode": "write", "parameters": { "kilograms": { "type": "number", "min": 5, "max": 1 } } }
    ],
    "accepted": false,
    "message": "\"kilograms\" of \"setWeight\" has a min above its max"
  },
