[
  {
    "name": "a colour prop accepts any colour written as #rrggbb",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "accent",
        "value": "#7b2ff7"
      }
    ],
    "expect": {
      "items": {
        "table": {
          "w": 12,
          "h": 4,
          "hidden": false,
          "props": {
            "accent": "#7b2ff7",
            "rows": 10,
            "opacity": 1,
            "stripes": "none"
          }
        }
      }
    }
  },
  {
    "name": "a colour may use capital letters",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "accent",
        "value": "#7B2FF7"
