          "props": {
            "accent": "#1c5cab",
            "rows": 50,
            "opacity": 1,
            "stripes": "none"
          }
        }
      }
    }
  },
  {
    "name": "a number prop without `integer` accepts fractions",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "opacity",
        "value": 0.35
      }
    ],
    "expect": {
      "items": {
        "table": {
          "w": 12,
          "h": 4,
          "hidden": false,
          "props": {
            "accent": "#1c5cab",
            "rows": 10,
            "opacity": 0.35,
            "stripes": "none"
          }
        }
      }
    }
  },
  {
    "name": "typed and listed props change together",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "accent",
        "value": "#b91c1c"
      },
      {
        "type": "setProp",
        "id": "table",
        "prop": "rows",
        "value": 40
      },
      {
        "type": "setProp",
        "id": "table",
        "prop": "stripes",
        "value": "grey"
      }
    ],
    "expect": {
      "items": {
        "table": {
          "w": 12,
          "h": 4,
          "hidden": false,
          "props": {
            "accent": "#b91c1c",
            "rows": 40,
            "opacity": 1,
            "stripes": "grey"
          }
        }
      }
    }
  },
  {
    "name": "a colour name is not a colour code",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "accent",
        "value": "purple"
      }
    ],
    "expect": {
      "errors": [
        {
          "index": 0,
          "code": "invalid_value",
          "message": "\"accent\" of \"table\" must be a colour written as #rrggbb"
        }
      ]
    }
  },
