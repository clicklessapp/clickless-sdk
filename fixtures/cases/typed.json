    "name": "a number prop accepts its limits",
    "manifest": "styles",
    "operations": [
      {
        "type": "setProp",
        "id": "table",
        "prop": "rows",
        "value": 5
      },
      {
        "type": "setProp",
        "id": "table",
        "prop": "rows",
        "value": 50
      }
    ],
    "expect": {
      "items": {
        "table": {
          "w": 12,
          "h": 4,
